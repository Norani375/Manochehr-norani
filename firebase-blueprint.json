{
  "entities": {
    "PersonnelNode": {
      "title": "Personnel Node",
      "description": "Organizational chart personnel node for Barakatullah Ghafouri Exchange",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Personnel ID"
        },
        "name": {
          "type": "string",
          "description": "Full Name in Dari/Pashto"
        },
        "title": {
          "type": "string",
          "description": "Official Job Title"
        },
        "category": {
          "type": "string",
          "description": "Organizational category"
        },
        "key": {
          "type": "string",
          "description": "Unique node key"
        }
      },
      "required": ["id", "name", "title", "category", "key"]
    },
    "CompanyMetadata": {
      "title": "Company Metadata",
      "description": "Company document header settings including issue date and custom logo",
      "type": "object",
      "properties": {
        "issueDate": {
          "type": "string",
          "description": "Document issue date"
        },
        "customLogo": {
          "type": "string",
          "description": "Base64 or URL custom logo"
        }
      },
      "required": ["issueDate"]
    },
    "MeetingMinutesData": {
      "title": "Meeting Minutes Data",
      "description": "Data for meeting minutes document",
      "type": "object",
      "properties": {
        "meetingData": { "type": "object" },
        "updatedAt": { "type": "string" }
      }
    },
    "LicenseRenewalLetterData": {
      "title": "License Renewal Letter Data",
      "description": "Data for license renewal letter document",
      "type": "object",
      "properties": {
        "letterData": { "type": "object" },
        "updatedAt": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/personnel/{personnelKey}": {
      "schema": {
        "$ref": "#/entities/PersonnelNode"
      },
      "description": "Collection of all organizational chart personnel and branch representatives"
    },
    "/settings/company": {
      "schema": {
        "$ref": "#/entities/CompanyMetadata"
      },
      "description": "Company global settings and document header metadata"
    },
    "/settings/meeting_minutes_v1": {
      "schema": {
        "$ref": "#/entities/MeetingMinutesData"
      },
      "description": "Meeting minutes official records"
    },
    "/settings/license_renewal_letter_v2": {
      "schema": {
        "$ref": "#/entities/LicenseRenewalLetterData"
      },
      "description": "Official license renewal letter data"
    }
  }
}
