rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function sameCompany(companyId) {
      return signedIn() && request.auth.token.companyId == companyId;
    }

    match /companies/{companyId}/renewal-documents/{fileName} {
      allow read: if isAdmin() || sameCompany(companyId);
      allow create, update: if isAdmin() || (sameCompany(companyId) && request.resource.size < 10 * 1024 * 1024);
      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
